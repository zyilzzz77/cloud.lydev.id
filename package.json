{
  "name": "lydev-cloud",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "build": "cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:e2e": "cross-env NODE_ENV=test playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:dev": "cross-env NODE_ENV=development tsx scripts/seed-dev-user.ts",
    "plan:set": "cross-env NODE_ENV=development tsx scripts/set-plan.ts",
    "topup:approve": "cross-env NODE_ENV=development tsx scripts/approve-topup.ts",
    "worker:cleanup": "cross-env NODE_ENV=development NODE_OPTIONS=--conditions=react-server tsx scripts/worker-cleanup.ts",
    "cloudflare:cdn": "node scripts/cloudflare-cdn-setup.mjs",
    "worker:deploy": "node scripts/deploy-worker.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.2.0",
    "geist": "^1.8.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
