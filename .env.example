NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=http://localhost:3000
NEXT_PUBLIC_SHORT_URL=http://localhost:3000
NEXT_PUBLIC_DL_URL=http://localhost:3000

DATABASE_URL=postgresql://lydev@127.0.0.1:55432/lydev_cloud
REDIS_URL=

JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_ISSUER=cloud.lydev.id
SESSION_TTL_DAYS=7

COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_APP_ID=
COS_ENDPOINT=
COS_CDN_DOMAIN=

# Cloudflare R2 is preferred when configured.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SESSION_TOKEN=
R2_CDN_ACCESS_KEY_ID=
R2_CDN_SECRET_ACCESS_KEY=
R2_CDN_SESSION_TOKEN=
R2_FILES_ACCESS_KEY_ID=
R2_FILES_SECRET_ACCESS_KEY=
R2_FILES_SESSION_TOKEN=
R2_CDN_BUCKET=lydev-cdn
R2_FILES_BUCKET=lydev-files
R2_CDN_DOMAIN=cdn.lydev.id
STORAGE_PRIMARY=r2

# Server-side Cloudflare actions: Zone Cache Purge for lydev.id + Workers KV write
# (account:write) for edge short-link sync. In production use a scoped API token
# with exactly: Zone.Cache Purge, Account.Workers KV Write, Account.Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_CDN_HOST=cdn.lydev.id

# HMAC secret for private CDN links. Must match the Worker secret.
CDN_SIGNING_SECRET=

STORAGE_QUOTA_BYTES=5368709120
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=524288000
MAX_RAW_BYTES=104857600
MAX_DL_BYTES=2147483648
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300

# Transactional email (Sumopod SMTP). Leave the credentials empty in development
# and the verification code is written to the server log instead of being sent.
SMTP_HOST=smtp.sumopod.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@cloud.lydev.id
MAIL_FROM_NAME=Lydev Cloud
