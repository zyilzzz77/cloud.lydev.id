# Cloudflare API token scoped to the lydev.id zone.
# Permissions: Zone Read, DNS Edit, Cache Rules Edit, Zone Settings Edit, Cache Purge.
CLOUDFLARE_API_TOKEN=

# Optional if the token can see only one zone.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=lydev.id

# Public IPv4 address of the VPS running Caddy and Next.js.
VPS_IP=

# Tencent COS bucket custom-domain target, without a scheme.
# Example: bucket-1250000000.cos.ap-southeast-1.myqcloud.com
COS_CDN_TARGET=

# strict requires a valid certificate on the origin. Use full while testing.
CLOUDFLARE_SSL_MODE=strict

# Set to true after the COS custom domain is bound and verified.
ENABLE_CDN_CACHE_RULE=true
